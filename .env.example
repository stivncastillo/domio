# Copia este archivo a ".env" (o ".env.local") y completa con los valores
# de tu proyecto de Supabase (Project Settings -> API).
#
# EXPO_PUBLIC_* se embebe en el bundle de la app: es publico por diseno,
# la seguridad real la dan las Row Level Security policies en Supabase.

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY
